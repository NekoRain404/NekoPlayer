# Maintainer: NekoRain <yukathleenlxy@gmail.com>
pkgname=nekoplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="A compact Qt 6 and libmpv desktop media player"
url='https://github.com/NekoRain404/NekoPlayer'
arch=('x86_64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-translations' 'mpv' 'ffmpeg' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-tools' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/NekoRain404/NekoPlayer/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('8f68de2ccfdb3b6927d4001067a4979f7f836ee9cc56822fc73133c22a877d50')

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
