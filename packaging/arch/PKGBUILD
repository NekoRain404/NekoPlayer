# Maintainer: NekoRain <yukathleenlxy@gmail.com>
# Tracks the latest published GitHub release. Update pkgver, the source URL
# and sha256sums together when a new release asset is available.
pkgname=nekoplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="A compact Qt 6 and libmpv desktop media player"
url='https://github.com/NekoRain404/NekoPlayer'
arch=('x86_64')
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-translations' 'mpv' 'ffmpeg' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-tools' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/NekoRain404/NekoPlayer/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('c55795e1d251224c3f957fc401d20bc03c8122ab532508826600ac1119677bf8')

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
